{
  "expo": {
    "name": "SR2Go",
    "slug": "sr2go-mobile",
    "scheme": "sr2go",
    "version": "1.10.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.shareride2go.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.shareride2go.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-asset",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "SR2Go uses the camera to scan boarding codes at the car."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SR2Go shares your position with your passengers every 5 minutes during a trip."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0099F9"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2463317f-3243-435d-9a19-f67b53c9091e"
      }
    },
    "owner": "shareride2go-ltd"
  }
}
