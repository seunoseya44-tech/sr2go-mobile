# Base URL of the ShareRide2Go API (no trailing slash)
EXPO_PUBLIC_API_BASE_URL=https://shareride2go.com

# Request timeout in milliseconds
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Optional, DEV BUILDS ONLY: prefills the login form so you can test faster.
# These are ignored in release builds. Never commit real credentials.
EXPO_PUBLIC_DEV_TEST_EMAIL=
EXPO_PUBLIC_DEV_TEST_PASSWORD=
